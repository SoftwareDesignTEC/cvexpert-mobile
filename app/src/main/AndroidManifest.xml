<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para consumir los mocks del APIM (T3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber si hay conexión: lo muestra el indicador de la barra superior. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ubicación aproximada (red/wifi) para "Usar mi ubicación" en el perfil. No se pide la
         precisa: para llenar ciudad y provincia no hace falta el GPS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Avisos push (Android 13+ lo pide en tiempo de ejecución, después del login). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CvApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CvPro"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CvPro"
            android:windowSoftInputMode="adjustResize">
            <!-- Declara esta Activity como la que abre el launcher del teléfono. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe los push de FCM y los tokens nuevos. exported=false: solo lo llama Google Play. -->
        <service
            android:name=".data.notifications.CvMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Cómo dibuja Android los avisos que llegan con la app cerrada: canal, ícono y color.
             El canal lo crea CvApplication con el mismo id (PushNotifications.CHANNEL_ID). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cvexpert_avisos" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_blue" />

        <!-- Permite entregarle el PDF generado al visor que tenga el usuario, sin exponer
             la ruta real del archivo. Solo hace falta en Android 9 y anteriores: desde
             Android 10 el archivo va a Descargas con MediaStore. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
